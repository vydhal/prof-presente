# Copie este arquivo para ".env" (na raiz, ao lado do docker-compose.dev.yml) e
# preencha com valores reais. O ".env" nunca é versionado (ver .gitignore).
#
# É lido automaticamente pelo Docker Compose para substituir os ${...} usados
# em docker-compose.dev.yml. Sem esse arquivo, o ambiente de dev sobe normalmente,
# mas o envio de e-mail fica sem credenciais válidas.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=ti@simplisoft.com.br
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=ti@simplisoft.com.br

# Opcional — ver back/.env-modelo para o contexto completo (contorno de DMARC ausente
# no domínio do governo). Deixe em branco se não for esse o caso.
EMAIL_REPLY_TO=
EMAIL_BCC=
