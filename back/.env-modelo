# Database
DATABASE_URL="postgresql://cracha_user:cracha123@localhost:5432/cracha_virtual_dev?schema=public"

# JWT Secret
JWT_SECRET="cracha_virtual_jwt_secret_key_2023"

# Server Configuration
PORT=3000
NODE_ENV=development

# URL pública da API (usada para montar URLs absolutas de imagens em e-mails/crachás,
# e como fallback do PUBLIC_LOGO_URL). Sem ela, imagens em e-mails ficam quebradas.
PUBLIC_API_URL=http://localhost:3000/api

# Integração com YouTube (login/streaming ao vivo, ver src/services/youtubeService.js)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# URL do microsserviço de reconhecimento facial (ver facialrec/)
FACIAL_SERVICE_URL=http://localhost:8000

# Email Configuration (para futuras implementações)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true # true para 465, false para outros como 587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-do-gmail
EMAIL_FROM="Nome do Seu Evento <seu-email@gmail.com>"

# Opcional. Use quando o domínio do EMAIL_FROM não tiver DMARC publicado (comum em
# órgãos .gov.br cujo DNS não controlamos) e por isso e-mails para Hotmail/Outlook/etc
# forem rejeitados (bounce 550 5.7.515). Nesse caso, configure EMAIL_FROM com um
# domínio que já tenha SPF+DKIM+DMARC válidos, e EMAIL_REPLY_TO com o e-mail real que
# deve receber as respostas. Sem isso definido, nenhum Reply-To é enviado.
EMAIL_REPLY_TO=